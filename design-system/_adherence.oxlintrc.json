{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/geo/**",
              "components/media/**",
              "ui_kits/report/**",
              "ui_kits/viewer/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:ABNES|Tactic Sans|Andale Mono ES))/i]",
        "message": "Font not provided by the design system. Available: ABNES, Tactic Sans, Andale Mono ES."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnalysisCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:analysis|result|unit|interpretation|ramp|rampLabels|level|source|visual|style|key|ref|className|style|children)$/]",
        "message": "<AnalysisCard> doesn't accept that prop. Declared props: analysis, result, unit, interpretation, ramp, rampLabels, level, source, visual, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnalysisCard'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:measured|verified|calculated|estimated|approximate|conceptual)$/]",
        "message": "<AnalysisCard> level must be one of 'measured' | 'verified' | 'calculated' | 'estimated' | 'approximate' | 'conceptual'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:beforeSrc|afterSrc|beforeLabel|afterLabel|ratio|initial|style|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: beforeSrc, afterSrc, beforeLabel, afterLabel, ratio, initial, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoundaryLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:types|showNotes|style|key|ref|className|style|children)$/]",
        "message": "<BoundaryLegend> doesn't accept that prop. Declared props: types, showNotes, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|instrument)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'instrument'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|source|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceTag> doesn't accept that prop. Declared props: level, source, style."
